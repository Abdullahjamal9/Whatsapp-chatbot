PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=whatsapp_bot
DB_PORT=3306
NODE_ENV=development

# ── Email (conversation history) ─────────────────────────────────────────────
# For Gmail: enable 2FA → create an App Password → paste it as SMTP_PASS
# Docs: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Brand label used in email sender name and auth/security emails
BRAND_NAME=PTIS Chatbot

# Bot display name used in emails
BOT_NAME=PTIS Chatbot

# ── Zoom Meeting Automation (optional) ───────────────────────────────────────
# Create a Server-to-Server OAuth app in Zoom and copy these values.
# If not provided, bot will detect meeting intent but won't create links.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# Meeting defaults
MEETING_TIMEZONE=Asia/Karachi
MEETING_DURATION_MINUTES=30
